{
  "name": "ewa",
  "version": "1.0.0",
  "description": "EWA — десктопное приложение для учета клиентов и фестивального продвижения фильмов",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "vue-tsc --noEmit && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win",
    "build:win:unsigned": "npm run build && electron-builder --win --config.win.signAndEditExecutable=false",
    "pack:win": "npm run build && electron-builder --win --dir --config.win.signAndEditExecutable=false",
    "build:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.0",
    "lucide-vue-next": "^0.475.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.2.0"
  },
  "author": "lildar",
  "license": "ISC"
}
